# === Docker / Compose ===
MYSQL_ROOT_PASSWORD=changeme     
DB_USER=boardy                      
COMPOSE_PROJECT_NAME=boardy

# === Laravel ===
APP_NAME=Boardy
APP_ENV=production                   
APP_KEY=base64:7DLy4k+LFW8Brtl7UKTiTvDUlXE5Z/GPBAVlUztHe10=
APP_DEBUG=false                         
APP_URL=http://localhost            

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# === Логи ===
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# === База данных ===
DB_CONNECTION=mysql
DB_HOST=mysql                  
DB_PORT=3306
DB_DATABASE=boardy_main
DB_USERNAME=boardy                   
DB_PASSWORD=changeme                 

# === Сессии / кэш / очереди ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

# === Redis ===
REDIS_CLIENT=predis
REDIS_HOST=redis                       
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=

# === Почта ===
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# === AWS ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

