# =====================================================================
#  .env.example — ШАБЛОН конфигурации Boardy (коммитим в git).
#
#  Быстрый старт на любой машине:
#     1) cp .env.example .env
#     2) поменять значения с пометкой  # CHANGE  на свои
#     3) (прод) сгенерировать ключ:  php artisan key:generate
#     4) локально:  docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
#        прод:      docker compose up -d
#
#  ВАЖНО: этот один файл обслуживает И docker compose, И Laravel.
#   - compose читает ${MYSQL_ROOT_PASSWORD}, ${DB_USER}, ${DB_PASSWORD}
#   - Laravel читает весь файл целиком (env_file)
#  Связки, которые должны совпадать:
#   - DB_USER (для MySQL-контейнера) == DB_USERNAME (для Laravel)
#   - DB_PASSWORD — одна строка, её берут и MySQL, и Laravel, и FastAPI
# =====================================================================

# === Docker / Compose ===
MYSQL_ROOT_PASSWORD=changeme           # CHANGE — пароль root в MySQL
DB_USER=boardy                         # имя прикладного пользователя MySQL
COMPOSE_PROJECT_NAME=boardy

# === Laravel: приложение ===
APP_NAME=Boardy
APP_ENV=production                      # локально можно local
# Рабочий тестовый ключ для локалки/CI. На ПРОДЕ заменить: php artisan key:generate
APP_KEY=base64:7DLy4k+LFW8Brtl7UKTiTvDUlXE5Z/GPBAVlUztHe10=
APP_DEBUG=false                         # локально можно true
APP_URL=http://localhost                # CHANGE на проде: https://boardy.cultuly.ai-info.ru

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# === Логи ===
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# === База данных (основная, всё кроме комментариев) ===
DB_CONNECTION=mysql
DB_HOST=mysql                           # имя контейнера, НЕ 127.0.0.1
DB_PORT=3306
DB_DATABASE=boardy_main
DB_USERNAME=boardy                      # == DB_USER выше
DB_PASSWORD=changeme                    # CHANGE — общий пароль БД (MySQL + Laravel + FastAPI)

# === Сессии / кэш / очереди ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

# === Redis ===
REDIS_CLIENT=predis
REDIS_HOST=redis                        # имя контейнера
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=

# === Почта ===
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# === AWS (не используется по умолчанию) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# === GitHub OAuth (вход через GitHub) — заполнить своими, реальные значения не коммитить ===
# GITHUB_CLIENT_ID=                       # CHANGE
# GITHUB_CLIENT_SECRET=                   # CHANGE
# GITHUB_REDIRECT_URI=http://localhost/auth/github/callback
#   прод: https://boardy.cultuly.ai-info.ru/auth/github/callback

# === Passport (OAuth-токены для SPA) ===
PASSPORT_CLIENT_ID=                       # CHANGE — выдаётся командой passport:client --public
PASSPORT_REDIRECT_URI="${APP_URL}/oauth/callback"

# === FastAPI ===
FASTAPI_DOMAIN=localhost                  # CHANGE на проде: boardy-api.cultuly.ai-info.ru
